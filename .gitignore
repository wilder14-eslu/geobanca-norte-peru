# Datos crudos: se reconstruyen con src/00_descargar_datos.py
# Excepción: OSM y catálogos SENAMHI se versionan (son pequeños y no se pueden reproducir igual)
data/raw/*
!data/raw/.gitkeep
!data/raw/osm/
!data/raw/senamhi/
data/raw/senamhi/historico/
data/raw/senamhi/red_actual/

# Intermedios y capas pesadas: se regeneran con src/01_construir_base_distrital.py
data/interim/*
!data/interim/.gitkeep
data/processed/*.gpkg
data/processed/*.gpkg-journal
data/processed/*.geojson

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

